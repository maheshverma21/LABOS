# Copy to deploy/.env and fill in. setup.sh does this for you and generates the secrets.
# Never commit the real .env.

# Your domain, without https://. Point its DNS A record at this server first.
DOMAIN=app.example.com
# For Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Long random strings (setup.sh generates them). Changing JWT_ACCESS_SECRET signs everyone out;
# changing SECRETS_KEY makes saved WhatsApp keys unreadable, so keep them safe.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
SECRETS_KEY=

# Email for password resets. Examples:
#   Hostinger mail:  smtps://no-reply%40yourdomain.in:PASSWORD@smtp.hostinger.com:465
#   AWS SES:         smtps://SMTP_USER:SMTP_PASS@email-smtp.ap-south-1.amazonaws.com:465
#   Brevo:           smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
# (an @ in the username is written %40)
SMTP_URL=
MAIL_FROM=LabOS <no-reply@example.com>

# Optional: your shared AiSensy account for labs without their own.
AISENSY_API_KEY=
AISENSY_CAMPAIGN=

# Backups: days to keep, and the hour (UTC) to take them. 21 UTC = 2:30 am IST.
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=21
