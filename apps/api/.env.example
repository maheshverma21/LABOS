# --- Server ---
NODE_ENV=development
PORT=4000
# The Next.js app's origin (used for CORS)
WEB_ORIGIN=http://localhost:3000

# --- PostgreSQL (Neon / Supabase) ---
# Pooled connection string, used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/lms?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma migrations.
# Neon: the same URL without "-pooler" in the host. Supabase: port 5432 instead of 6543.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/lms?sslmode=require"

# --- Redis (Upstash) ---
# Use the "rediss://" (TLS) URL from the Upstash console
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# --- Auth ---
# Generate with: npm run secret -w api
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime in seconds (15 minutes)
ACCESS_TOKEN_TTL=900
# Refresh token / session lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# --- Reports ---
# Public address of the web app; report links and WhatsApp PDFs point here.
# Must be reachable from the internet for WhatsApp to fetch the PDF.
# PUBLIC_BASE_URL=https://app.example.com
# Optional: separate key for encrypting labs' saved API keys (32+ chars).
# SECRETS_KEY=

# --- WhatsApp (AiSensy) ---
# The shared platform account, used by labs that don't add their own.
# The campaign must be Live and use a document-header template with two
# params: {{1}} patient name, {{2}} lab name.
# AISENSY_API_KEY=
# AISENSY_CAMPAIGN=lab_report
