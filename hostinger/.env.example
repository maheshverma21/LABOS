# Environment variables to enter in Hostinger hPanel > Node.js app > Environment variables.
# Never commit real values.

# Your public https address, no trailing slash.
WEB_ORIGIN=https://lab.yourdomain.com

# Hostinger has no PostgreSQL. Use a free/cheap external one (Neon, Supabase, Aiven, Railway...).
# Use the DIRECT (non-pooled) connection string for DIRECT_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Hostinger has no Redis. Use Upstash (free) and copy its rediss:// URL.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Long random strings (32+ chars). Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep them safe: changing JWT_ACCESS_SECRET signs everyone out, changing SECRETS_KEY breaks saved WhatsApp keys.
JWT_ACCESS_SECRET=
SECRETS_KEY=

# Email (password resets). Hostinger mail example (@ in username written as %40):
SMTP_URL=smtps://no-reply%40yourdomain.com:PASSWORD@smtp.hostinger.com:465
MAIL_FROM=LabOS <no-reply@yourdomain.com>

# Optional
AISENSY_API_KEY=
AISENSY_CAMPAIGN=
